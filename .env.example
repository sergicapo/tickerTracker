# HTTP Basic Auth credentials for the API (CHANGE THESE)
API_USER=admin
API_PASSWORD=changeme

# Database — relative path for local runs, use sqlite:////data/ticker_tracker.db in Docker
DATABASE_URL=sqlite:///./data/ticker_tracker.db

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Current-price snapshot frequency (minutes)
FETCH_INTERVAL_MINUTES=5

# How far back to download daily history (YYYY-MM-DD)
HISTORICAL_START_DATE=2020-01-01

# Retention for intraday snapshots (days); cleaned up daily at 01:00 UTC
INTRADAY_RETENTION_DAYS=30

# Optional: Alpha Vantage fallback if Yahoo Finance fails
# ALPHA_VANTAGE_API_KEY=
